[Unit]
Description=marta-pi looping playback
After=systemd-user-sessions.service
# Media lives on the USB stick; don't start before it is mounted.
RequiresMountsFor=/mnt/usb

[Service]
User=admin
WorkingDirectory=/home/admin/marta-pi

# X gets vt7 of its own and switches to it. Do not point this at vt1: the getty
# there owns that terminal, and systemd's TTY handling would SIGHUP us.
ExecStart=/usr/bin/startx /usr/bin/python3 /home/admin/marta-pi/main.py -- vt7

StandardOutput=journal
StandardError=journal

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
